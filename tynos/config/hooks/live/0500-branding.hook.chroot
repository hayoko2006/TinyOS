#!/bin/sh
# TinyOS 0500: 系统集成与品牌化（os-release / APT 源 / SDDM 自动登录）
set -e

echo "[TinyOS] 写入系统标识 /etc/os-release"
# 口味标识由构建脚本注入（TINYOS_EDITION），缺省为 stable
EDITION="stable"
if [ -f /etc/tinyos-edition ]; then
    EDITION="$(cat /etc/tinyos-edition)"
fi
cat > /usr/lib/os-release <<EOF
NAME="TinyOS"
VERSION="1.0.0 (Trixie)"
ID=tinyos
ID_LIKE=debian
PRETTY_NAME="TinyOS 1.0.0 ${EDITION} (基于 Debian 13 trixie 稳定版)"
VERSION_ID="1.0.0"
VERSION_CODENAME=trixie
DEBIAN_VERSION_FULL=13.7
VARIANT="${EDITION}"
VARIANT_ID=${EDITION}
HOME_URL="https://tiny.hayoko.cn/"
SUPPORT_URL="https://tiny.hayoko.cn/"
BUG_REPORT_URL="https://tiny.hayoko.cn/"
LOGO=tinyos-logo
ANSI_COLOR="0;36"
EOF
rm -f /etc/os-release
ln -s ../usr/lib/os-release /etc/os-release

echo "[TinyOS] 配置软件源（默认中科大；备用含国内与官方/国际节点）"
cat > /etc/apt/sources.list <<'EOF'
# TinyOS 默认软件源 —— 中国科学技术大学 (USTC)
deb https://mirrors.ustc.edu.cn/debian/ trixie main contrib non-free non-free-firmware
deb https://mirrors.ustc.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware
deb https://mirrors.ustc.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware
deb https://mirrors.ustc.edu.cn/debian/ trixie-backports main contrib non-free

# 切换方法：运行 sudo tinyos-mirror 自动测速优选，
# 或注释上方四行、取消注释下方任一镜像的对应四行。
# 海外用户建议直接使用 Debian 官方 CDN。

# == 国内镜像 ==
# 清华大学 TUNA
# deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware
# deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware
# deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware
# deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-backports main contrib non-free
# 阿里云
# deb https://mirrors.aliyun.com/debian/ trixie main contrib non-free non-free-firmware
# deb https://mirrors.aliyun.com/debian/ trixie-updates main contrib non-free non-free-firmware
# deb https://mirrors.aliyun.com/debian-security/ trixie-security main contrib non-free non-free-firmware
# deb https://mirrors.aliyun.com/debian/ trixie-backports main contrib non-free
# 腾讯云
# deb https://mirrors.cloud.tencent.com/debian/ trixie main contrib non-free non-free-firmware
# deb https://mirrors.cloud.tencent.com/debian/ trixie-updates main contrib non-free non-free-firmware
# deb https://mirrors.cloud.tencent.com/debian-security/ trixie-security main contrib non-free non-free-firmware
# 华为云
# deb https://mirrors.huaweicloud.com/debian/ trixie main contrib non-free non-free-firmware
# deb https://mirrors.huaweicloud.com/debian/ trixie-updates main contrib non-free non-free-firmware
# deb https://mirrors.huaweicloud.com/debian-security/ trixie-security main contrib non-free non-free-firmware
# 上海交通大学
# deb https://mirror.sjtu.edu.cn/debian/ trixie main contrib non-free non-free-firmware
# deb https://mirror.sjtu.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware
# deb https://mirror.sjtu.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware
# 网易
# deb https://mirrors.163.com/debian/ trixie main contrib non-free non-free-firmware
# deb https://mirrors.163.com/debian/ trixie-updates main contrib non-free non-free-firmware
# deb https://mirrors.163.com/debian-security/ trixie-security main contrib non-free non-free-firmware

# == 国际镜像 ==
# Debian 官方 (全球 CDN，海外推荐)
# deb https://deb.debian.org/debian/ trixie main contrib non-free non-free-firmware
# deb https://deb.debian.org/debian/ trixie-updates main contrib non-free non-free-firmware
# deb https://security.debian.org/debian-security/ trixie-security main contrib non-free non-free-firmware
# deb https://deb.debian.org/debian/ trixie-backports main contrib non-free
# Kernel.org (北美)
# deb https://mirrors.kernel.org/debian/ trixie main contrib non-free non-free-firmware
# deb https://mirrors.kernel.org/debian/ trixie-updates main contrib non-free non-free-firmware
# deb https://security.debian.org/debian-security/ trixie-security main contrib non-free non-free-firmware
# Hetzner (欧洲)
# deb https://mirror.hetzner.com/debian/ trixie main contrib non-free non-free-firmware
# deb https://mirror.hetzner.com/debian/ trixie-updates main contrib non-free non-free-firmware
# deb https://security.debian.org/debian-security/ trixie-security main contrib non-free non-free-firmware
# JAIST (日本)
# deb https://ftp.jaist.ac.jp/pub/Linux/debian/ trixie main contrib non-free non-free-firmware
# deb https://ftp.jaist.ac.jp/pub/Linux/debian/ trixie-updates main contrib non-free non-free-firmware
# deb https://security.debian.org/debian-security/ trixie-security main contrib non-free non-free-firmware
# AARNet (澳洲)
# deb https://mirror.aarnet.edu.au/debian/ trixie main contrib non-free non-free-firmware
# deb https://mirror.aarnet.edu.au/debian/ trixie-updates main contrib non-free non-free-firmware
# deb https://security.debian.org/debian-security/ trixie-security main contrib non-free non-free-firmware
EOF

echo "[TinyOS] APT 加速参数（并发下载 + 断点重试）"
cat > /etc/apt/apt.conf.d/99tinyos <<'EOF'
Acquire::Retries "3";
Acquire::http::Timeout "20";
Acquire::ForceIPv4 "false";
APT::Install-Recommends "true";
EOF

echo "[TinyOS] SDDM 自动登录（Live 环境免密进入桌面）"
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/99-tinyos-live.conf <<'EOF'
[Autologin]
User=user
Session=plasma
Relogin=false

[General]
RebootCommand=/usr/sbin/shutdown -r now
HaltCommand=/usr/sbin/shutdown -h now
EOF

echo "[TinyOS] Live 用户提权规则"
cat > /etc/sudoers.d/tinyos-live <<'EOF'
user ALL=(ALL) NOPASSWD: ALL
EOF
chmod 440 /etc/sudoers.d/tinyos-live

echo "[TinyOS] 主机名与登录提示"
echo "tinyos" > /etc/hostname
cat > /etc/issue <<'EOF'
 _____   _   _ __    _   _    ___    ____
|_   _| (_) | '_ \  | | | |  / _ \  / ___|
  | |   | | | | | | | |_| | | | | | \___ \
  | |   | | |_| |_|  \__, | |_| |_|  ___) |
  |_|   |_|         |___/   \___/  |____/

      TinyOS 1.0.0  ·  Debian 13 trixie  ·  \n \l
      兼容层: Wine (Windows) + Waydroid (Android)
      软件源: 中国科学技术大学镜像（默认）
      官网: https://tiny.hayoko.cn  ·  邮箱: hayoko@hayoko.cn
EOF

echo "[TinyOS] 品牌化完成"
